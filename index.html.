<!doctype html><html lang="es"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="theme-color" content="#071427"><title>Tech Soporte | Catálogo de programas</title><style>:root{--bg:#071427;--panel:#10233b;--line:#27405c;--blue:#36b8ff;--text:#eef7ff;--muted:#a8bdd1}*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--text);font-family:Inter,system-ui,Arial,sans-serif}a{text-decoration:none;color:inherit}.wrap{max-width:1160px;margin:auto;padding:0 22px}header{position:sticky;top:0;z-index:10;background:#071427ee;backdrop-filter:blur(14px);border-bottom:1px solid var(--line)}.nav{display:flex;align-items:center;justify-content:space-between;gap:20px;min-height:76px}.logo{font-weight:900;font-size:21px;letter-spacing:-.6px}.logo span{color:var(--blue)}nav{display:flex;gap:22px;color:#c5d8e9;font-size:14px}.btn{display:inline-flex;align-items:center;justify-content:center;border-radius:11px;padding:13px 20px;font-weight:750;background:#20c775;color:#062416;border:0;cursor:pointer}.btn.secondary{background:#153451;color:white;border:1px solid #3c6284}.hero{position:relative;overflow:hidden;background:radial-gradient(ellipse at 80% 15%,#12537e 0,transparent 42%),linear-gradient(130deg,#071427,#0c2340);padding:90px 0 100px}.hero-grid{display:grid;grid-template-columns:1.2fr .8fr;align-items:center;gap:40px}.eyebrow{color:#73d5ff;font-size:12px;font-weight:800;letter-spacing:2px;text-transform:uppercase}.hero h1{font-size:clamp(38px,5vw,66px);line-height:1.08;letter-spacing:-2px;margin:16px 0}.hero h1 em{font-style:normal;color:#4bc6ff}.hero p{font-size:18px;line-height:1.65;color:#bcd0e2;max-width:600px}.actions{display:flex;gap:12px;flex-wrap:wrap;margin-top:28px}.visual{min-height:310px;border:1px solid #2a6a97;border-radius:24px;background:linear-gradient(145deg,#153f65,#08172a);box-shadow:0 30px 90px #0006;display:flex;align-items:center;justify-content:center;position:relative;overflow:hidden}.visual:before{content:'';position:absolute;width:250px;height:250px;border:2px solid #36b8ff44;border-radius:50%;box-shadow:0 0 0 45px #36b8ff10,0 0 0 90px #36b8ff08}.screen{position:relative;background:#0b1d31;border:9px solid #283e56;border-radius:16px;width:73%;padding:20px;box-shadow:0 20px 50px #0008}.screen b{color:#66d0ff}.screen .bars{display:flex;align-items:end;gap:10px;height:100px;margin-top:18px}.bars i{flex:1;background:linear-gradient(#4bc6ff,#1566a0);border-radius:5px 5px 0 0}.bars i:nth-child(1){height:35%}.bars i:nth-child(2){height:65%}.bars i:nth-child(3){height:45%}.bars i:nth-child(4){height:85%}.bars i:nth-child(5){height:60%}.section{padding:75px 0}.section h2{font-size:34px;margin:0 0 12px;letter-spacing:-1px}.sub{color:var(--muted);line-height:1.6;margin:0 0 27px}.tools{display:flex;gap:12px;flex-wrap:wrap;margin-bottom:24px}input{flex:1;min-width:220px;padding:15px 17px;background:#112740;border:1px solid #35536e;border-radius:11px;color:white;font:inherit;outline:none}input:focus{border-color:var(--blue)}.filters{display:flex;flex-wrap:wrap;gap:8px}.filter{background:#10243a;color:#c7d8e9;border:1px solid #2e4861;border-radius:30px;padding:11px 15px;cursor:pointer}.filter.active{background:#2b9bd4;color:#061727;border-color:#2b9bd4;font-weight:800}.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}.card{border:1px solid #28425b;background:linear-gradient(150deg,#142c46,#0d1e32);border-radius:17px;padding:24px;display:flex;flex-direction:column;min-height:235px;transition:transform .2s,border-color .2s}.card:hover{transform:translateY(-4px);border-color:#45bfff}.tag{color:#69cfff;font-size:12px;font-weight:800;text-transform:uppercase;letter-spacing:1px}.card h3{font-size:24px;margin:18px 0 10px}.card p{color:#aec3d7;line-height:1.55;flex:1;margin:0 0 20px}.card a{color:#62d2ff;font-weight:800}.features{background:#0b1e32;border-top:1px solid #213b56;border-bottom:1px solid #213b56}.feature-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}.feature{padding:20px;border:1px solid #2c4964;border-radius:15px;background:#122941}.feature strong{font-size:19px}.feature p{color:#b4c8da;line-height:1.6}.contact{background:linear-gradient(120deg,#0c3454,#0a1a30);border:1px solid #306188;border-radius:22px;padding:40px;display:flex;align-items:center;justify-content:space-between;gap:24px}.contact h2{margin:0 0 10px}.contact p{color:#bed2e4;margin:0}footer{padding:35px 0;color:#9bb4c8;font-size:13px}.foot{display:flex;justify-content:space-between;gap:15px;flex-wrap:wrap}.float{position:fixed;bottom:20px;right:20px;z-index:20;box-shadow:0 8px 30px #0008}.empty{color:#a8bdd1;display:none;padding:20px 0}@media(max-width:850px){nav{display:none}.hero-grid{grid-template-columns:1fr}.visual{min-height:230px}.grid{grid-template-columns:repeat(2,1fr)}.feature-grid{grid-template-columns:1fr}.hero{padding:60px 0}.contact{flex-direction:column;align-items:start}}@media(max-width:580px){.grid{grid-template-columns:1fr}.section{padding:52px 0}.hero h1{letter-spacing:-1px}.nav>.btn{padding:10px 12px;font-size:13px}.contact{padding:26px}.float{bottom:12px;right:12px}}</style></head><body><header><div class="wrap nav"><a href="#inicio" class="logo">TECH <span>SOPORTE</span></a><nav><a href="#catalogo">Catálogo</a><a href="#servicios">Servicios</a><a href="#contacto">Contacto</a></nav><a class="btn" id="topwa" target="_blank" rel="noopener">WhatsApp ↗</a></div></header><main><section class="hero" id="inicio"><div class="wrap hero-grid"><div><div class="eyebrow">Tecnología para negocios y profesionales</div><h1>El software que necesitas para <em>llevar tus proyectos más lejos.</em></h1><p>Explora programas de punto de venta, restaurantes, ingeniería, diseño dental y más. Solicita información y atención personalizada por WhatsApp.</p><div class="actions"><a class="btn secondary" href="#catalogo">Explorar catálogo ↓</a><a class="btn" id="herowa" target="_blank" rel="noopener">Consultar por WhatsApp ↗</a></div></div><div class="visual" aria-hidden="true"><div class="screen"><b>Tu negocio, mejor conectado</b><div class="bars"><i></i><i></i><i></i><i></i><i></i></div></div></div></div></section><section class="section" id="catalogo"><div class="wrap"><h2>Catálogo de programas</h2><p class="sub">Encuentra la solución que buscas. Selecciona un programa para consultar detalles, versiones y disponibilidad.</p><div class="tools"><input id="search" type="search" placeholder="Buscar un programa..." aria-label="Buscar programa"><div class="filters" id="filters"></div></div><div class="grid" id="products"></div><p class="empty" id="empty">No se encontraron programas con ese nombre.</p></div></section><section class="section features" id="servicios"><div class="wrap"><h2>Atención y servicios</h2><p class="sub">Acompañamiento para encontrar la herramienta adecuada.</p><div class="feature-grid"><div class="feature"><strong>💬 Atención personalizada</strong><p>Resolvemos tus dudas sobre las funciones y versiones disponibles.</p></div><div class="feature"><strong>💻 Soluciones digitales</strong><p>Programas para negocios, diseño, administración y proyectos profesionales.</p></div><div class="feature"><strong>🛠️ Asesoría y soporte</strong><p>Consulta las opciones de instalación, configuración y asistencia para cada producto.</p></div></div></div></section><section class="section" id="contacto"><div class="wrap"><div class="contact"><div><h2>¿Buscas un programa específico?</h2><p>Escríbenos y solicita información sin compromiso.</p></div><a class="btn" id="contactwa" target="_blank" rel="noopener">Hablar por WhatsApp ↗</a></div></div></section></main><footer><div class="wrap foot"><span>© <span id="year"></span> Tech Soporte. Todos los derechos reservados.</span><span>Catálogo informativo · Marcas de terceros pertenecen a sus titulares.</span></div></footer><a class="btn float" id="floatwa" target="_blank" rel="noopener" aria-label="Contactar por WhatsApp">✆ WhatsApp</a><script>const PHONE='529512092799';const wa=t=>'https://wa.me/'+PHONE+'?text='+encodeURIComponent(t);for(const id of ['topwa','herowa','contactwa','floatwa'])document.getElementById(id).href=wa('Hola, quiero información sobre sus programas.');document.getElementById('year').textContent=new Date().getFullYear();const data=[['Eleventa','Punto de venta','Sistema para administrar ventas, inventario y operaciones de tu negocio.'],['SoftRestaurant','Restaurantes','Solución de gestión para restaurantes y establecimientos de alimentos.'],['SoftHoteles','Restaurantes','Herramientas para la administración de hospedaje.'],['My Business POS','Punto de venta','Gestión comercial, ventas y control de productos.'],['4Parking Plus','Punto de venta','Software de administración para estacionamientos.'],['Exocad','Diseño dental','Herramientas CAD para diseño de restauraciones dentales.'],['Exoplan','Diseño dental','Planeación digital de tratamientos e implantología.'],['PartialCAD','Diseño dental','Diseño digital de estructuras para prótesis parciales.'],['Blue Sky Plan','Diseño dental','Software para planificación dental digital.'],['Blender Dental','Diseño dental','Herramientas de diseño y modelado dental.'],['Opus','Ingeniería','Presupuestos, costos y administración de obras.'],['Neodata','Ingeniería','Análisis de precios unitarios y presupuestos de construcción.'],['CivilCAD','Ingeniería','Herramientas para dibujo y proyectos de ingeniería civil.'],['AutoCAD','Ingeniería','Diseño y dibujo técnico asistido por computadora.'],['CYPECAD','Ingeniería','Análisis y diseño de estructuras.'],['Promob','Diseño y producción','Diseño y presentación de muebles y espacios.'],['SAi Flexi','Diseño y producción','Herramientas de diseño y producción gráfica.'],['SolidWorks','Diseño y producción','Modelado y diseño mecánico en 3D.'],['Aspel','Administración','Soluciones administrativas, contables y de nómina.'],['Nitro PDF','Administración','Edición y gestión de documentos PDF.']];const cats=['Todos',...new Set(data.map(x=>x[1]))];let active='Todos';const filters=document.getElementById('filters'),products=document.getElementById('products'),search=document.getElementById('search');function render(){filters.innerHTML='';cats.forEach(c=>{const b=document.createElement('button');b.className='filter'+(c===active?' active':'');b.textContent=c;b.onclick=()=>{active=c;render()};filters.appendChild(b)});products.innerHTML='';const q=search.value.toLocaleLowerCase('es').trim();const rows=data.filter(x=>(active==='Todos'||x[1]===active)&&x.join(' ').toLocaleLowerCase('es').includes(q));document.getElementById('empty').style.display=rows.length?'none':'block';rows.forEach(([name,cat,desc])=>{const card=document.createElement('article');card.className='card';const tag=document.createElement('div');tag.className='tag';tag.textContent=cat;const title=document.createElement('h3');title.textContent=name;const p=document.createElement('p');p.textContent=desc;const a=document.createElement('a');a.href=wa('Hola, quiero información sobre '+name+'. ¿Qué versiones tienen disponibles?');a.target='_blank';a.rel='noopener';a.textContent='Consultar por WhatsApp ↗';card.append(tag,title,p,a);products.appendChild(card)})}search.addEventListener('input',render);render();</script></body></html>
